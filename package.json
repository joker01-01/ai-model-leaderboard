{
  "name": "ai-model-almanac",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "模型年鉴 · AI 模型排行榜（编辑加权、口径可调）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "modelops:data": "tsx scripts/export-modelops-data.ts",
    "modelops:data:check": "tsx scripts/export-modelops-data.ts --check",
    "test:modelops-data": "tsx --test scripts/modelops-data.test.ts",
    "preview": "vite preview",
    "sync:data": "node scripts/sync-data.mjs",
    "sync:data:check": "node scripts/sync-data.mjs --check"
  },
  "dependencies": {
    "hyparquet": "^1.28.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
