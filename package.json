{
  "name": "ai-model-almanac",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "基于完整 Artificial Analysis 数据的 AI 模型能力、速度与价格排行榜",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "modelops:data": "tsx scripts/export-modelops-data.ts",
    "modelops:data:check": "tsx scripts/export-modelops-data.ts --check",
    "test:data-update-policy": "node --test scripts/data-update-policy.test.mjs scripts/aa-leaderboard.test.mjs scripts/aa-public-snapshot.test.mjs scripts/sync-data.public.test.mjs",
    "test:agent": "vitest run src/features/agent",
    "test:frontend": "vitest run src",
    "test:modelops-data": "tsx --test scripts/modelops-data.test.ts",
    "preview": "vite preview",
    "sync:data": "node scripts/sync-data.mjs",
    "sync:data:check": "node scripts/sync-data.mjs --check"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "hyparquet": "^1.28.2",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
